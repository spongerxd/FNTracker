  "Juno_UpdateItemData": {
    "B2D2288E46DC8D78827B23A638B1B077": "Обычный топор. Идеально подходит для рубки деревьев… или самообороны.",
    "7CB9F76A4597E83BCABB02B1BF4CB829": "Обычный арбалет. Самое то для хорошей перестрелки.",
    "B29291824A6DD7F5982F7D8F741CA84F": "Обычный кинжал. То, что надо для ближнего боя. Наносит критический урон при ударах со спины.",
    "9D9805C14B7AB83836B11D85C201BE6D": "Обычное мачете. Отлично разрезает кусты и опасные растения.",
    "1D70BE7242DD41810C1027B2A8523638": "Обычная кирка. С ней можно собирать камень и эффективно разрушать постройки.",
    "095887624A5D76B0EAE571BBC6BC2798": "Обычное копьё для ближнего или дальнего боя. Нажмите, чтобы атаковать. Зажмите, чтобы бросить.",
    "F3E8BF43433BA03A63BC8482CD53274B": "Обычный меч. Идеален для ближнего боя.",
    "7CF409744D7B83E5180CBE80AFAF26F6": "Легендарный кинжал из иной реальности. Идеален для ближнего боя. Наносит критический урон при ударах со спины.",
    "E7B866D34FEA6855B74A5B8D56C88559": "Легендарное мачете Из иной реальности. Отлично разрезает кусты и опасные растения.",
    "C9B55874497611D1854DACA09C73D7A8": "Легендарное копьё из иной реальности для ближнего или дальнего боя. Нажмите, чтобы атаковать. Зажмите, чтобы бросить.",
    "A60C95B3484DD3B81129C0B646569FBE": "Редкий топор. Идеально подходит для рубки деревьев… или самообороны.",
    "534E2E624D3CD2D30F1D948053F04597": "Редкий арбалет. Самое то для хорошей перестрелки.",
    "16CA58DC4A877F2FC08CD8868C0E3FDC": "Редкий кинжал. То, что надо для ближнего боя. Наносит критический урон при ударах со спины.",
